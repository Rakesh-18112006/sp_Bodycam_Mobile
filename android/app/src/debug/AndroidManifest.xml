<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- DEBUG BUILDS ONLY: allow plain-http traffic to a local development backend (for example http://10.0.2.2:8000).
         The main manifest turns cleartext off for every other build type. Receivers still refuse plain http unless the
         build was also made with --dart-define=ALLOW_INSECURE_RECEIVER=true. -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic"/>
</manifest>
